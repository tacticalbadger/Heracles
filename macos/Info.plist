<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>CFBundleName</key>
  <string>Heracles</string>
  <key>CFBundleDisplayName</key>
  <string>Heracles</string>
  <key>CFBundleExecutable</key>
  <string>Heracles</string>
  <!-- The icon, which build-app.sh copies into Resources from macos/Icon/:
       by name from Assets.car, and Heracles.icns as the plain file. -->
  <key>CFBundleIconName</key>
  <string>Heracles</string>
  <key>CFBundleIconFile</key>
  <string>Heracles</string>
  <!-- Not the original app's id (com.heracles.notes), so the two never
       shared preferences. Every installed copy's settings and its updates
       hang on this id: do not change it. -->
  <key>CFBundleIdentifier</key>
  <string>com.heracles.notes.native</string>
  <key>CFBundlePackageType</key>
  <string>APPL</string>
  <key>CFBundleShortVersionString</key>
  <string>0.4.0</string>
  <!-- The build number. Sparkle goes by this, not by the version above, to
       tell whether an update is newer: raise it with every release.
       release.sh stops if it is not higher than the published one. -->
  <key>CFBundleVersion</key>
  <string>7</string>
  <key>LSMinimumSystemVersion</key>
  <string>14.0</string>
  <key>LSApplicationCategoryType</key>
  <string>public.app-category.productivity</string>
  <key>NSHighResolutionCapable</key>
  <true/>
  <key>NSPrincipalClass</key>
  <string>NSApplication</string>
  <!-- Updates over the air (Sparkle). The app looks once a day, and takes
       an update only if the feed and the archive are both signed with the
       update key. build-app.sh adds the feed's address (SUFeedURL) and the
       key's public half (SUPublicEDKey) from macos/update-config.sh. -->
  <key>SUEnableAutomaticChecks</key>
  <true/>
  <key>SURequireSignedFeed</key>
  <true/>
  <key>SUVerifyUpdateBeforeExtraction</key>
  <true/>
  <!-- heracles://note/<id> links open the note they name. -->
  <key>CFBundleURLTypes</key>
  <array>
    <dict>
      <key>CFBundleURLName</key>
      <string>Heracles note link</string>
      <key>CFBundleURLSchemes</key>
      <array>
        <string>heracles</string>
      </array>
    </dict>
  </array>
</dict>
</plist>
